POSTGRES_DB=english_for_developers
POSTGRES_USER=english_dev
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://english_dev:local-only-change-me@localhost:5432/english_for_developers
TEST_DATABASE_URL=postgresql+psycopg://english_dev:local-only-change-me@localhost:5432/english_for_developers_test

# Telegram login (optional). Client ID from @BotFather -> bot -> Login Widget
# (OpenID Connect mode). It is not a secret; the Client Secret is not used.
# Empty or unset disables Telegram login. E2E tests ignore it.
# TELEGRAM_CLIENT_ID=

# --- Production stack (deploy/compose.production.yaml) ---
# Production uses a SEPARATE env file passed with --env-file, e.g.:
#   docker compose --env-file .env.production -f deploy/compose.production.yaml ...
# `.env.*` is git-ignored, so .env.production is never committed. These lines
# are the template for it and are commented out (the dev keys above already
# define POSTGRES_*), so this file stays a valid dev env file.
#
# POSTGRES_PASSWORD: generate a long random value, e.g.
#   openssl rand -hex 32
# never reuse the local password above.
# Use only URL-safe characters (hex): the password is embedded in DATABASE_URL, so base64 characters /+= break the URL.
# POSTGRES_DB=english_for_developers
# POSTGRES_USER=english_dev
# POSTGRES_PASSWORD=
# EXPECTED_ORIGIN=https://example.invalid
# HTTP_PORT=8080
# DOMAIN: the public host name for the VPS TLS front (deploy/compose.vps.yaml).
# Its A record must point to the VPS before the first start, and EXPECTED_ORIGIN
# must then be https://$DOMAIN.
# DOMAIN=demo.example.com
# TELEGRAM_CLIENT_ID=
